# Copy to .env for local development. Never commit .env.
# All values are optional unless marked required.

# Required to ask questions (not needed to run tests)
OPENAI_API_KEY=
# Shared password for the app; leave empty to disable the gate locally
APP_PASSWORD=

# Models per stage (chosen after the model comparison spike)
LLM_MODEL_GENERATE=
LLM_MODEL_EXPLAIN=

# Limits (ADR 0014)
MAX_UPLOAD_MB=50
MAX_ROWS=2000000
MAX_COLUMNS=300
QUERY_TIMEOUT_S=10
MAX_RESULT_ROWS=10000
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
MAX_CORRECTIONS=2
MAX_LLM_CALLS=5
RATE_LIMIT_QUESTIONS=20
RATE_LIMIT_WINDOW_S=600
SESSION_IDLE_MINUTES=60

# Region rules (ADR 0009)
DEFAULT_REGION=NZ

# Logging
LOG_LEVEL=INFO
# true only for local debugging: SQL can contain values from the data
LOG_SQL_TEXT=false
